---
import { ArrowRight, ChevronLeft, ChevronRight, Leaf, Star } from "@lucide/astro";
import Button from "@components/common/Button.astro";
import Container from "@components/common/Container.astro";
import EditorialImage from "@components/common/EditorialImage.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { site } from "@content/site";
import { withBase } from "@content/paths";
import { reviews } from "@content/reviews";

const categories = [
  {
    title: "Lashes & Brows",
    image: "/images/lashes-category.jpg",
    href: "/services/",
    imageClass: "object-[60%_center]",
    alt: "Lash tools, tweezers, towel, amber bottles, and olive branches in a warm workstation",
    description: "Soft definition, careful shaping, and beauty work that still feels like you."
  },
  {
    title: "Facials & Skin",
    image: "/images/facials-category.jpg",
    href: "/services/",
    imageClass: "object-[68%_center]",
    alt: "Skincare towels, serum bottles, bowls, and greenery in a warm spa setting",
    description: "Skin care for glow, balance, and a little more ease in your day."
  },
  {
    title: "Sound & Healing Experiences",
    image: "/images/sound-healing-category.jpg",
    href: "/services/#wellness",
    imageClass: "object-[68%_center]",
    alt: "Crystal singing bowls in a warm sound bath studio",
    description: "Good energy, gentle sound, and space to let your whole system settle."
  }
];

const testimonials = reviews.map((review) => review.excerpt);
const homeHours = [
  "Sunday: Closed",
  "Monday: Closed",
  "Tuesday: 9:00 AM–3:00 PM",
  "Wednesday: 9:00 AM–3:00 PM",
  "Thursday: 9:00 AM–3:00 PM",
  "Friday: 9:00 AM–3:00 PM",
  "Saturday: 10:00 AM–2:00 PM"
];
---

<BaseLayout
  title="Sassy Alchemy | Boutique Beauty & Wellness Studio"
  description="Editorial beauty and wellness experiences in a calm boutique studio: lashes, facials, restorative wellness, and sound bath rituals."
  image="/images/home-hero-sound-bath.png"
  preloadImage={true}
>
  <section class="relative h-[clamp(34rem,calc(100svh-5rem),50rem)] overflow-hidden bg-ivory pt-20 text-forest-900">
    <img
      src={withBase("/images/home-hero-sound-bath.png")}
      alt="Sound bath setup with colorful crystal bowls, candles, and warm studio lighting at Sassy Alchemy"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover object-[30%_44%] sm:object-[42%_44%] lg:object-[50%_44%]"
    />
    <div
      class="absolute inset-y-0 left-0 w-[88%] sm:w-[58%] lg:w-[44%]"
      style="background: radial-gradient(ellipse at 22% 42%, rgba(255, 250, 240, 0.46) 0%, rgba(255, 247, 232, 0.24) 38%, rgba(255, 247, 232, 0.08) 66%, rgba(255, 247, 232, 0) 100%);"
    ></div>

    <Container class="relative flex h-full items-center pb-8 pt-4" size="wide">
      <div class="max-w-[22rem] -translate-y-7 sm:max-w-[26rem] sm:-translate-y-5">
        <p class="mb-5 text-[0.7rem] font-semibold uppercase text-gold-deep">Beauty • Healing • Self-Care</p>
        <h1 class="max-w-[22rem] text-[2.05rem] leading-[0.92] text-forest-900 sm:max-w-[25rem] sm:text-[2.8rem] lg:text-[3.1rem]">
          Rituals for the<br />
          face, body, and<br />
          nervous system.
        </h1>
        <p class="magic-line mt-6 max-w-xs font-serif text-lg italic leading-snug text-gold-deep sm:text-xl">
          A little beauty. A little healing.<br class="hidden sm:block" />
          A little magic.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={site.bookingUrl} variant="secondary">Book</Button>
          <Button href={withBase("/services/")} variant="secondary">
            Explore Experiences
          </Button>
        </div>
      </div>
    </Container>
  </section>

  <section class="bg-cream pb-18 pt-12 sm:pb-22 sm:pt-16 lg:pb-30 lg:pt-18">
    <Container size="wide">
      <div class="grid gap-6 lg:grid-cols-[0.7fr_1.3fr] lg:items-end">
        <div>
          <p class="text-xs font-semibold uppercase text-gold-deep">Featured categories</p>
          <h2 class="mt-4 text-5xl leading-none sm:text-6xl">Whatever you’re in the mood for.</h2>
        </div>
        <p class="max-w-2xl text-lg leading-8 text-stone-600 lg:justify-self-end">
          Lashes, skin, sound, healing — maybe a little of everything. Find what feels good today.
        </p>
      </div>

      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {categories.map((category) => (
          <a
            href={withBase(category.href)}
            class="image-frame group relative min-h-[32rem] overflow-hidden bg-forest-900 text-ivory transition duration-500 ease-editorial hover:-translate-y-1 focus-visible:-translate-y-1"
          >
            <img
              src={withBase(category.image)}
              alt={"alt" in category && category.alt ? category.alt : `${category.title} placeholder`}
              loading="lazy"
              decoding="async"
              class:list={[
                "absolute inset-0 h-full w-full object-cover opacity-80 transition duration-700 ease-editorial group-hover:scale-[1.035] group-hover:opacity-60",
                "imageClass" in category && category.imageClass
              ]}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-forest-900/90 via-forest-900/20 to-transparent"></div>
            <div class="relative flex h-full min-h-[32rem] flex-col justify-end p-7 sm:p-8">
              <div class="mb-8 h-px w-20 bg-gold-muted transition duration-500 group-hover:w-28"></div>
              <div class="flex items-end justify-between gap-6">
                <div>
                  <h3 class="text-4xl leading-none text-ivory sm:text-5xl">{category.title}</h3>
                  <p class="mt-4 max-w-sm text-cream/0 transition duration-500 group-hover:text-cream/80 motion-reduce:text-cream/80 max-lg:text-cream/80">
                    {category.description}
                  </p>
                </div>
                <ArrowRight
                  aria-hidden="true"
                  size={24}
                  stroke-width={1.4}
                  class="mb-1 shrink-0 text-gold-muted transition duration-500 group-hover:translate-x-1"
                />
              </div>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <section class="bg-ivory py-18 sm:py-22 lg:py-30">
    <Container class="grid gap-8 lg:grid-cols-[0.52fr_1.48fr] lg:items-center">
      <EditorialImage src="/images/lisa-home.jpg" alt="Lisa in the Sassy Alchemy studio with singing bowls" ratio="portrait" class="max-h-[30rem]" />
      <div class="relative max-w-2xl">
        <p class="text-xs font-semibold uppercase text-gold-deep">Meet Lisa</p>
        <h2 class="mt-5 text-5xl leading-none sm:text-6xl">The heart behind Sassy Alchemy.</h2>
        <span aria-hidden="true" class="gold-pen-mark mt-5 block"></span>
        <p class="mt-7 text-lg leading-8 text-stone-600">
          Lisa is the hands, heart, and good energy behind Sassy Alchemy — blending beauty, Reiki, sound, and a whole lot of care into every experience.
        </p>
        <p class="mt-6 border-y border-stone-200 py-5 text-sm font-semibold uppercase tracking-[0.14em] text-forest-900">
          Licensed Esthetician • Reiki Practitioner • Sound Bath Practitioner
        </p>
        <Button href={withBase("/about/")} variant="secondary" class="mt-8">Meet Lisa</Button>
      </div>
    </Container>
  </section>

  <section class="bg-cream py-18 sm:py-22 lg:py-30">
    <Container class="grid gap-10 lg:grid-cols-[1.12fr_0.88fr] lg:items-center" size="wide">
      <EditorialImage
        src="/images/mind-body-frequency-facial.png"
        alt="Mind Body Frequency Facial with Reiki and sound healing at Sassy Alchemy."
        ratio="landscape"
        class="h-[28rem] aspect-auto [&>img]:object-[48%_center] sm:[&>img]:object-[52%_center] lg:[&>img]:object-[54%_center]"
      />
      <div class="max-w-xl lg:justify-self-end">
        <p class="group text-xs font-semibold uppercase text-gold-deep">
          This is where the magic happens
        </p>
        <h2 class="mt-5 text-5xl leading-none sm:text-6xl">Mind • Body • Frequency Facial</h2>
        <p class="mt-6 text-lg leading-8 text-stone-600">
          A restorative facial experience combining personalized skincare, Reiki, and a private sound bath to leave you feeling refreshed, grounded, and deeply restored.
        </p>
        <Button href={withBase("/services/#facials-skin")} class="mt-8">Explore Facials</Button>
      </div>
    </Container>
  </section>

  <section class="overflow-hidden bg-forest-900 text-ivory">
    <Container class="grid gap-10 py-18 sm:py-22 lg:grid-cols-[0.84fr_1.16fr] lg:items-center lg:py-30" size="wide">
      <div class="max-w-xl">
        <p class="text-xs font-semibold uppercase text-gold-muted">Wellness feature</p>
        <h2 class="mt-5 text-5xl leading-none text-ivory sm:text-6xl">Sound Bath Experiences</h2>
        <p class="mt-5 font-serif text-2xl italic leading-none text-gold-muted sm:text-3xl">
          Good energy lives here.
        </p>
        <p class="mt-6 text-lg leading-8 text-cream/75">
          Immersive sessions for rest, release, and a slower return to yourself.
        </p>
        <Button href={withBase("/services/#wellness")} variant="secondary" class="mt-8">Explore Healing</Button>
      </div>
      <EditorialImage
        src="/images/enhance-wellness-photo.png"
        alt="Sound bath setup with crystal singing bowls, candles, string lights, sage, and ritual objects at Sassy Alchemy."
        ratio="landscape"
        class="border border-cream/15 [&>img]:object-[50%_56%] sm:[&>img]:object-[50%_54%]"
      />
    </Container>
  </section>

  <section class="bg-cream py-18 sm:py-22 lg:py-30">
    <Container size="wide">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase text-gold-deep">Reviews</p>
          <h2 class="mt-4 text-5xl leading-none sm:text-6xl">Client notes worth lingering on.</h2>
        </div>
        <div class="flex gap-2" aria-label="Testimonial carousel controls">
          <button
            type="button"
            data-carousel-prev
            class="flex h-12 w-12 items-center justify-center border border-stone-200 bg-ivory text-forest-900 shadow-[0_10px_24px_rgba(16,42,32,0.06)] transition duration-300 ease-editorial hover:-translate-y-0.5 hover:border-forest-900 hover:bg-forest-900 hover:text-ivory"
            aria-label="Previous testimonial"
          >
            <ChevronLeft aria-hidden="true" size={20} stroke-width={1.5} />
          </button>
          <button
            type="button"
            data-carousel-next
            class="flex h-12 w-12 items-center justify-center border border-stone-200 bg-ivory text-forest-900 shadow-[0_10px_24px_rgba(16,42,32,0.06)] transition duration-300 ease-editorial hover:-translate-y-0.5 hover:border-forest-900 hover:bg-forest-900 hover:text-ivory"
            aria-label="Next testimonial"
          >
            <ChevronRight aria-hidden="true" size={20} stroke-width={1.5} />
          </button>
        </div>
      </div>

      <div
        data-testimonial-track
        class="mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth pb-4 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {testimonials.map((quote) => (
          <figure class="surface-soft min-w-[86%] snap-start p-8 sm:min-w-[32rem] lg:min-w-[42rem] lg:p-10">
            <div class="flex gap-1 text-gold-deep" aria-label="Five-star review">
              {Array.from({ length: 5 }).map(() => (
                <Star aria-hidden="true" size={17} stroke-width={1.4} fill="currentColor" />
              ))}
            </div>
            <blockquote class="mt-10 font-serif text-4xl leading-tight text-forest-900 sm:text-5xl">
              "{quote}"
            </blockquote>
            <figcaption class="mt-8 text-sm font-semibold uppercase text-stone-600">Featured client review</figcaption>
          </figure>
        ))}
      </div>
    </Container>
  </section>

  <section class="bg-ivory py-18 sm:py-22 lg:py-30">
    <Container class="grid gap-10 lg:grid-cols-[0.78fr_1.22fr] lg:items-stretch" size="wide">
      <div class="flex flex-col justify-between">
        <div>
          <p class="text-xs font-semibold uppercase text-gold-deep">Visit</p>
          <h2 class="mt-5 text-5xl leading-none sm:text-6xl">Find your way to the studio.</h2>
          <p class="mt-6 font-serif text-2xl italic leading-snug text-gold-deep sm:text-3xl">
            Come as you are. Leave a little lighter.
          </p>
        </div>
        <div class="mt-10 grid gap-6 border-y border-stone-200 py-7">
          <div>
            <p class="text-sm font-semibold uppercase text-forest-900">Location</p>
            <p class="mt-2 text-stone-600">{site.contact.address}</p>
          </div>
          <div>
            <p class="text-sm font-semibold uppercase text-forest-900">Hours</p>
            <div class="mt-2 grid gap-1 text-stone-600">
              {homeHours.map((line) => <p>{line}</p>)}
            </div>
          </div>
          <div>
            <p class="text-sm font-semibold uppercase text-forest-900">Accessibility</p>
            <p class="mt-2 text-stone-600">{site.contact.accessibility}</p>
          </div>
        </div>
        <Button href={site.bookingUrl} class="mt-8">Book</Button>
      </div>

      <a
        href={site.googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="image-frame group/map relative min-h-[28rem] overflow-hidden bg-stone-100 transition duration-500 ease-editorial hover:-translate-y-1 focus-visible:-translate-y-1"
        aria-label="Open Sassy Alchemy in Google Maps"
      >
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(16,42,32,0.12)_1px,transparent_1px),linear-gradient(rgba(16,42,32,0.12)_1px,transparent_1px)] bg-[size:56px_56px]"></div>
        <div class="absolute left-1/2 top-1/2 flex h-24 w-24 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-gold-muted bg-ivory text-forest-900 shadow-soft transition duration-500 group-hover/map:scale-105">
          <Leaf aria-hidden="true" size={28} stroke-width={1.4} />
        </div>
        <div class="absolute bottom-6 left-6 right-6 border border-stone-200 bg-ivory/90 p-5 backdrop-blur">
          <p class="text-sm font-semibold uppercase text-forest-900">Google Maps</p>
          <p class="mt-2 text-sm text-stone-600">Open in Google Maps</p>
        </div>
      </a>
    </Container>
  </section>

  <script>
    const track = document.querySelector("[data-testimonial-track]");
    const previous = document.querySelector("[data-carousel-prev]");
    const next = document.querySelector("[data-carousel-next]");

    const scrollByCard = (direction: number) => {
      if (!(track instanceof HTMLElement)) return;
      const card = track.querySelector("figure");
      const distance = card instanceof HTMLElement ? card.offsetWidth + 20 : track.clientWidth * 0.85;
      track.scrollBy({ left: distance * direction, behavior: "smooth" });
    };

    previous?.addEventListener("click", () => scrollByCard(-1));
    next?.addEventListener("click", () => scrollByCard(1));
  </script>
</BaseLayout>
