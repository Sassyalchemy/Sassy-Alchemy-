---
import { ArrowUpRight, Quote, Star } from "@lucide/astro";
import Container from "@components/common/Container.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { reviews } from "@content/reviews";
import { site } from "@content/site";

const featuredReviews = reviews.slice(0, 3);
const supportingReviews = reviews.slice(3);
---

<BaseLayout
  title="Reviews | Sassy Alchemy"
  description="Read real five-star Google reviews for Sassy Alchemy, a boutique beauty and wellness studio."
>
  <section class="bg-ivory pt-28 sm:pt-32 lg:pt-36">
    <Container class="grid gap-10 py-16 sm:py-20 lg:grid-cols-[0.9fr_1.1fr] lg:items-end lg:py-24" size="wide">
      <div>
        <p class="text-xs font-semibold uppercase text-gold-deep">Reviews</p>
        <h1 class="mt-5 max-w-4xl text-balance text-6xl leading-[0.92] sm:text-7xl lg:text-8xl">
          What Clients Are Saying
        </h1>
      </div>
      <div class="max-w-2xl lg:pb-2">
        <p class="text-lg leading-8 text-stone-600">
          Real experiences shared by clients of Sassy Alchemy.
        </p>
        <a
          href={site.googleReviewsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group/review mt-8 inline-flex min-h-12 items-center gap-3 border border-forest-900 bg-forest-900 px-5 py-3 text-sm font-semibold uppercase text-ivory shadow-[0_12px_28px_rgba(16,42,32,0.12)] transition duration-300 ease-editorial hover:-translate-y-0.5 hover:border-gold-muted hover:bg-gold-muted hover:text-forest-900 focus-visible:-translate-y-0.5 active:translate-y-0"
        >
          <span>View Google Reviews</span>
          <ArrowUpRight aria-hidden="true" size={16} stroke-width={1.6} class="transition duration-300 ease-editorial group-hover/review:translate-x-0.5 group-hover/review:-translate-y-0.5" />
        </a>
      </div>
    </Container>
  </section>

  <section class="bg-cream py-18 sm:py-22 lg:py-30">
    <Container size="wide">
      <div class="grid gap-5 lg:grid-cols-[1.08fr_0.92fr]">
        <figure class="bg-forest-900 p-8 text-ivory sm:p-10 lg:min-h-[34rem] lg:p-12">
          <Quote aria-hidden="true" size={34} stroke-width={1.2} class="text-gold-muted" />
          <div class="mt-12 flex gap-1 text-gold-muted" aria-label="Five-star review">
            {Array.from({ length: 5 }).map(() => (
              <Star aria-hidden="true" size={18} stroke-width={1.3} fill="currentColor" />
            ))}
          </div>
          <blockquote class="mt-8 max-w-4xl font-serif text-4xl leading-tight text-ivory sm:text-5xl lg:text-6xl">
            "{featuredReviews[0].quote}"
          </blockquote>
          <figcaption class="mt-10 text-sm font-semibold uppercase text-cream/70">
            Verified Google Review
          </figcaption>
        </figure>

        <div class="grid gap-5">
          {featuredReviews.slice(1).map((review) => (
            <figure class="surface-soft p-8 sm:p-10">
              <div class="flex gap-1 text-gold-deep" aria-label="Five-star review">
                {Array.from({ length: 5 }).map(() => (
                  <Star aria-hidden="true" size={17} stroke-width={1.3} fill="currentColor" />
                ))}
              </div>
              <blockquote class="mt-8 font-serif text-3xl leading-tight text-forest-900 sm:text-4xl">
                "{review.quote}"
              </blockquote>
              <figcaption class="mt-8 text-sm font-semibold uppercase text-stone-600">Verified Google Review</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <section class="bg-ivory py-18 sm:py-22 lg:py-30">
    <Container>
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-semibold uppercase text-gold-deep">More notes</p>
        <h2 class="mt-5 text-5xl leading-none sm:text-6xl">A smooth rhythm of care.</h2>
      </div>

      <div class="mt-14 grid gap-8 md:grid-cols-2">
        {supportingReviews.map((review, index) => (
          <figure class="border-t border-stone-200 pt-8 transition duration-500 ease-editorial hover:-translate-y-1 hover:border-gold-muted">
            <div class="flex items-center justify-between gap-4">
              <p class="text-sm text-gold-deep">0{index + 4}</p>
              <div class="flex gap-1 text-gold-deep" aria-label="Five-star review">
                {Array.from({ length: 5 }).map(() => (
                  <Star aria-hidden="true" size={16} stroke-width={1.3} fill="currentColor" />
                ))}
              </div>
            </div>
            <blockquote class="mt-5 font-serif text-3xl leading-tight text-forest-900 sm:text-4xl">
              "{review.quote}"
            </blockquote>
            <figcaption class="mt-6 text-sm font-semibold uppercase text-stone-600">Verified Google Review</figcaption>
          </figure>
        ))}
      </div>

      <div class="surface-soft mx-auto mt-16 max-w-3xl p-8 text-center sm:p-10">
        <h2 class="mt-5 text-5xl leading-none sm:text-6xl">Had a beautiful experience?</h2>
        <p class="mx-auto mt-6 max-w-xl text-stone-600">
          Your feedback helps others discover Sassy Alchemy.
        </p>
        <a
          href={site.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group/review mt-8 inline-flex min-h-12 items-center gap-3 border border-forest-900 bg-forest-900 px-5 py-3 text-sm font-semibold uppercase text-ivory shadow-[0_12px_28px_rgba(16,42,32,0.12)] transition duration-300 ease-editorial hover:-translate-y-0.5 hover:border-gold-muted hover:bg-gold-muted hover:text-forest-900 focus-visible:-translate-y-0.5 active:translate-y-0"
        >
          <span>Leave a Google Review</span>
          <ArrowUpRight aria-hidden="true" size={16} stroke-width={1.6} class="transition duration-300 ease-editorial group-hover/review:translate-x-0.5 group-hover/review:-translate-y-0.5" />
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
