---
import { ArrowUpRight, ChevronDown, Eye, HandHeart, Leaf, Sparkles } from "@lucide/astro";
import Container from "@components/common/Container.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { withBase } from "@content/paths";
import { site } from "@content/site";

const categories = [
  {
    id: "lashes-brows",
    eyebrow: "Lashes & Brows",
    title: "Quiet definition, shaped with precision.",
    intro:
      "Polished lash and brow services designed to frame the face with softness, balance, and restraint.",
    image: "/images/lashes-placeholder.jpg",
    imageAlt: "Lashes and brows service atmosphere placeholder",
    Icon: Eye,
    services: [
      {
        title: "Classic Lash Extensions",
        description:
          "A refined full set for natural-looking length and definition, applied with attention to comfort and proportion."
      },
      {
        title: "Lash Extension Fill",
        description:
          "A maintenance appointment to refresh shed extensions, preserve shape, and keep the lash line looking seamless."
      },
      {
        title: "Lash Lift & Tint",
        description:
          "A low-maintenance lift and soft tint for lashes that appear more open, curved, and naturally enhanced."
      },
      {
        title: "Lash Tint",
        description:
          "A subtle tinting service that deepens the look of natural lashes without the commitment of extensions."
      },
      {
        title: "Brow Tint",
        description:
          "A soft color refresh to bring clarity and quiet structure to the natural brow."
      },
      {
        title: "Brow Shaping & Cleanup",
        description:
          "A precise brow service that refines the natural shape and removes unwanted growth for a clean, balanced finish."
      }
    ]
  },
  {
    id: "facials-skin",
    eyebrow: "Facials & Skin",
    title: "Skin rituals with a restorative point of view.",
    intro:
      "Facial treatments are approached as both visible skin care and a calmer, more considered studio experience.",
    image: "/images/facial-placeholder.jpg",
    imageAlt: "Facials and skin care atmosphere placeholder",
    Icon: Sparkles,
    services: [
      {
        title: "Alchemy Signature Facial",
        description:
          "A deeply considered facial ritual created for glow, balance, and an unrushed sense of restoration."
      },
      {
        title: "Customized Facial with Extractions",
        description:
          "A tailored treatment shaped around skin needs, including careful extractions where appropriate."
      },
      {
        title: "Back Facial",
        description:
          "A restorative treatment for the back, supporting clearer, softer, and more cared-for skin."
      },
      {
        title: "Microdermabrasion",
        description:
          "A resurfacing treatment that gently refines texture and supports a smoother, brighter appearance."
      },
      {
        title: "Chemical Peel",
        description:
          "A targeted exfoliating treatment selected to support tone, texture, clarity, and renewal."
      },
      {
        title: "Advanced Exfoliation Treatments",
        description:
          "A curated collection of advanced exfoliation options selected according to skin condition and desired outcome.",
        details: ["Glycolic", "Lactic", "Pumpkin", "Vitamin C", "Hydrating", "Salicylic"]
      }
    ]
  },
  {
    id: "wellness",
    eyebrow: "Wellness",
    title: "Restorative care for the whole system.",
    intro:
      "Peaceful, grounding services created for energetic ease, quiet reset, and a deeper return to self.",
    image: "/images/soundbath-placeholder.jpg",
    imageAlt: "Wellness and sound bath atmosphere placeholder",
    Icon: Leaf,
    peaceful: true,
    services: [
      {
        title: "Reiki",
        description:
          "A gentle energy session intended to support calm, balance, and a more settled internal state."
      },
      {
        title: "Reiki Facial",
        description:
          "A restorative facial experience paired with Reiki for skin care that feels peaceful and deeply held."
      },
      {
        title: "Sound Bath Experiences",
        description:
          "An immersive listening ritual designed for rest, release, and nervous-system restoration."
      }
    ]
  }
];
---

<BaseLayout
  title="Services | Sassy Alchemy"
  description="Explore Sassy Alchemy services across lashes and brows, facials and skin, and restorative wellness experiences."
>
  <section class="bg-ivory pt-28 sm:pt-32 lg:pt-36">
    <Container class="grid gap-10 py-16 sm:py-20 lg:grid-cols-[0.82fr_1.18fr] lg:items-end lg:py-24" size="wide">
      <div>
        <p class="text-xs font-semibold uppercase text-gold-deep">Services</p>
        <h1 class="mt-5 max-w-4xl text-balance text-6xl leading-[0.92] sm:text-7xl lg:text-8xl">
          Beauty and wellness, composed with intention.
        </h1>
      </div>
      <p class="max-w-2xl text-lg leading-8 text-stone-600 lg:pb-2">
        Three focused paths through the Sassy Alchemy experience: refined lash and brow care,
        restorative skin rituals, and peaceful wellness offerings.
      </p>
    </Container>
  </section>

  {categories.map((category, categoryIndex) => {
    const Icon = category.Icon;
    const isDark = category.peaceful;

    return (
      <section
        id={category.id}
        class:list={[
          "services-category",
          isDark ? "bg-forest-900 text-ivory" : categoryIndex % 2 === 0 ? "bg-cream" : "bg-ivory"
        ]}
      >
        <Container class="py-18 sm:py-22 lg:py-30" size="wide">
          <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-stretch">
            <figure class="image-frame group relative min-h-[26rem] overflow-hidden bg-stone-100 sm:min-h-[34rem]">
              <img
                src={withBase(category.image)}
                alt={category.imageAlt}
                loading={categoryIndex === 0 ? "eager" : "lazy"}
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover transition duration-700 ease-editorial group-hover:scale-[1.035]"
              />
              <div class:list={["absolute inset-0", isDark ? "bg-forest-900/18" : "bg-forest-900/8"]}></div>
            </figure>

            <div class="flex flex-col justify-between gap-10">
              <div>
                <div
                  class:list={[
                    "mb-8 flex h-16 w-16 items-center justify-center rounded-full border",
                    isDark ? "border-cream/20 bg-cream/8 text-gold-muted" : "border-stone-200 bg-ivory text-forest-900"
                  ]}
                >
                  <Icon aria-hidden="true" size={24} stroke-width={1.4} />
                </div>
                <p class:list={["text-xs font-semibold uppercase", isDark ? "text-gold-muted" : "text-gold-deep"]}>
                  {category.eyebrow}
                </p>
                <h2 class:list={["mt-5 max-w-3xl text-5xl leading-none sm:text-6xl", isDark && "text-ivory"]}>
                  {category.title}
                </h2>
                <p class:list={["mt-6 max-w-2xl text-lg leading-8", isDark ? "text-cream/75" : "text-stone-600"]}>
                  {category.intro}
                </p>
              </div>

              {isDark && (
                <div class="hidden border-l border-gold-muted/60 pl-6 text-cream/70 lg:block">
                  <p class="max-w-md">
                    A quieter path through the studio: gentle energy work, sensory rest, and rituals that support deep exhale.
                  </p>
                </div>
              )}
            </div>
          </div>

          <div class="mt-12 lg:mt-16">
            <div class:list={["divide-y", isDark ? "divide-cream/15 border-y border-cream/15" : "divide-stone-200 border-y border-stone-200"]}>
              {category.services.map((service, serviceIndex) => (
                <details class="service-panel group">
                  <summary
                    class:list={[
                      "grid cursor-pointer list-none gap-5 py-7 transition duration-300 ease-editorial sm:grid-cols-[4rem_1fr_auto] sm:items-center lg:py-8",
                      isDark ? "hover:bg-cream/[0.035]" : "hover:bg-ivory/70"
                    ]}
                  >
                    <span class:list={["text-sm", isDark ? "text-cream/55" : "text-stone-400"]}>
                      {String(serviceIndex + 1).padStart(2, "0")}
                    </span>
                    <span class:list={["font-serif text-3xl leading-tight sm:text-4xl", isDark ? "text-ivory" : "text-forest-900"]}>
                      {service.title}
                    </span>
                    <span
                      class:list={[
                        "flex h-11 w-11 items-center justify-center border transition duration-300 ease-editorial group-hover:-translate-y-0.5 group-open:rotate-180",
                        isDark ? "border-cream/20 bg-cream/[0.03] text-gold-muted group-hover:border-gold-muted" : "border-stone-200 bg-ivory text-gold-deep group-hover:border-forest-900"
                      ]}
                    >
                      <ChevronDown aria-hidden="true" size={20} stroke-width={1.5} />
                    </span>
                  </summary>

                  <div class="service-panel__content">
                    <div class="service-panel__inner grid gap-7 pb-8 sm:grid-cols-[4rem_1fr] lg:pb-10">
                      <div class="hidden sm:block"></div>
                      <div class="max-w-3xl">
                        <p class:list={["text-base leading-8 sm:text-lg", isDark ? "text-cream/75" : "text-stone-600"]}>
                          {service.description}
                        </p>

                        {"details" in service && service.details && (
                          <div class="mt-6 flex flex-wrap gap-2">
                            {service.details.map((detail) => (
                              <span
                                class:list={[
                                  "border px-3 py-2 text-sm transition duration-300",
                                  isDark ? "border-cream/15 text-cream/75" : "border-stone-200 bg-ivory text-stone-600 shadow-[0_8px_18px_rgba(16,42,32,0.035)]"
                                ]}
                              >
                                {detail}
                              </span>
                            ))}
                          </div>
                        )}

                        <a
                          href={site.bookingUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class:list={[
                            "group/book mt-7 inline-flex min-h-12 items-center gap-3 border px-5 py-3 text-sm font-semibold uppercase transition duration-300 ease-editorial hover:-translate-y-0.5 focus-visible:-translate-y-0.5 active:translate-y-0",
                            isDark
                              ? "border-cream/30 bg-cream text-forest-900 hover:border-gold-muted hover:bg-gold-muted"
                              : "border-forest-900 bg-forest-900 text-ivory hover:border-gold-muted hover:bg-gold-muted hover:text-forest-900"
                          ]}
                        >
                          <span>Book This Service</span>
                          <ArrowUpRight aria-hidden="true" size={16} stroke-width={1.6} class="transition duration-300 ease-editorial group-hover/book:translate-x-0.5 group-hover/book:-translate-y-0.5" />
                        </a>
                      </div>
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </div>
        </Container>
      </section>
    );
  })}

  <section class="bg-ivory">
    <Container class="py-16 text-center sm:py-20">
      <HandHeart aria-hidden="true" size={28} stroke-width={1.4} class="mx-auto text-gold-deep" />
      <h2 class="mx-auto mt-6 max-w-3xl text-5xl leading-none sm:text-6xl">
        Choose the ritual that meets you where you are.
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-stone-600">
        Final timing, pricing, and booking details live through Vagaro.
      </p>
      <a
        href={site.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group/book mt-8 inline-flex min-h-12 items-center gap-3 border border-forest-900 bg-forest-900 px-5 py-3 text-sm font-semibold uppercase text-ivory shadow-[0_12px_28px_rgba(16,42,32,0.12)] transition duration-300 ease-editorial hover:-translate-y-0.5 hover:border-gold-muted hover:bg-gold-muted hover:text-forest-900 focus-visible:-translate-y-0.5 active:translate-y-0"
      >
        <span>Book</span>
        <ArrowUpRight aria-hidden="true" size={16} stroke-width={1.6} class="transition duration-300 ease-editorial group-hover/book:translate-x-0.5 group-hover/book:-translate-y-0.5" />
      </a>
    </Container>
  </section>

  <style>
    .service-panel summary::-webkit-details-marker {
      display: none;
    }

    .service-panel summary {
      border-radius: 2px;
    }

    .service-panel__content {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      transition:
        grid-template-rows 520ms var(--ease-editorial),
        opacity 420ms var(--ease-editorial);
    }

    .service-panel[open] .service-panel__content {
      grid-template-rows: 1fr;
      opacity: 1;
    }

    .service-panel__inner {
      overflow: hidden;
    }
  </style>
</BaseLayout>
