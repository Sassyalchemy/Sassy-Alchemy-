---
import { ArrowUpRight, ChevronDown, Eye, HandHeart, Leaf, Sparkles } from "@lucide/astro";
import Container from "@components/common/Container.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { withBase } from "@content/paths";
import { site } from "@content/site";

const categories = [
  {
    id: "lashes-brows",
    eyebrow: "Lashes & Brows",
    title: "Your lashes, just better.",
    intro:
      "Extensions, lifts, tints and brow care — polished, pretty, and still completely you.",
    image: "/images/lashes-brows-service.png",
    imageAlt: "Professional lash extension tools and lash styling at Sassy Alchemy.",
    imageClass: "object-[56%_center] sm:object-[54%_center] lg:object-[52%_center]",
    Icon: Eye,
    services: [
      {
        title: "Lash Extensions",
        description:
          "Choose from classic, hybrid, volume, or mega volume lash extensions for a customized level of fullness, definition, and drama."
      },
      {
        title: "Lash Extension Fill",
        description:
          "Refresh and maintain your existing lash set. Choose from classic, hybrid, volume, or mega volume fills based on your current style."
      },
      {
        title: "Lash Lift & Tint",
        description:
          "A low-maintenance lift and tint that makes natural lashes appear darker, longer, and more open."
      },
      {
        title: "Lash Tint",
        description:
          "A subtle tint that deepens the appearance of natural lashes without extensions."
      },
      {
        title: "Lash Removal",
        description:
          "Professional removal of lash extensions while helping protect the natural lashes."
      },
      {
        title: "Brow Tint",
        description:
          "A soft color refresh that adds definition and structure to the natural brow."
      },
      {
        title: "Brow Shaping & Cleanup",
        description:
          "Precise shaping and removal of unwanted growth for a clean, balanced finish."
      }
    ]
  },
  {
    id: "facials-skin",
    eyebrow: "Facials & Skin",
    title: "Skin rituals that help you glow and exhale.",
    intro:
      "Facial treatments are approached as skin care, self-care, and a little time to come back to yourself.",
    image: "/images/facials-skin-service.png",
    imageAlt: "Restorative facial treatment at Sassy Alchemy Beauty & Wellness Studio.",
    imageClass: "object-[48%_center] sm:object-[46%_center] lg:object-[45%_center]",
    Icon: Sparkles,
    services: [
      {
        title: "The Alchemy Facial",
        description:
          "A personalized facial shaped around your skin’s needs, with carefully selected products and techniques for refreshed, balanced skin."
      },
      {
        title: "Customized Facial with Extractions",
        description:
          "A tailored facial that includes careful extractions where appropriate to support clearer, smoother skin."
      },
      {
        title: "Back Facial",
        description:
          "A restorative treatment for the back that supports clearer, softer, and more cared-for skin."
      },
      {
        title: "Microdermabrasion",
        description:
          "A resurfacing treatment that gently refines texture and supports a smoother, brighter appearance."
      },
      {
        title: "Chemical Peel",
        description:
          "A targeted exfoliating treatment selected to support tone, texture, clarity, and renewal."
      },
      {
        title: "Advanced Exfoliation Treatments",
        description:
          "A customized exfoliation option selected according to your skin’s needs.",
        details: ["Glycolic", "Lactic", "Pumpkin", "Vitamin C", "Hydrating", "Salicylic"]
      }
    ]
  },
  {
    id: "wellness",
    eyebrow: "Sound & Healing",
    sectionName: "Sound & Healing Experiences",
    title: "Come back to yourself.",
    intro:
      "Reiki, sound baths and facial experiences for slowing down, breathing deeper, and giving your energy a little care too.",
    image: "/images/sound-healing-service.png",
    imageAlt: "Singing bowls and sound healing instruments at Sassy Alchemy Beauty & Wellness Studio.",
    imageClass: "object-[45%_center] sm:object-[46%_center] lg:object-[48%_center]",
    Icon: Leaf,
    peaceful: true,
    supportLine:
      "Explore gentle energy work, soothing sound, and skin rituals that care for your outer glow and your inner steadiness.",
    serviceGroups: [
      {
        title: "Sound Bath & Reiki Experiences",
        services: [
          {
            title: "30-Minute Reiki Session",
            description:
              "A gentle energy session designed to support relaxation, balance, and a more settled internal state."
          },
          {
            title: "45-Minute Reiki Session",
            description:
              "A longer Reiki session offering additional time for relaxation, grounding, and energetic balance."
          },
          {
            title: "Personal Sound Bath Radiance Session",
            description:
              "A private sound bath using soothing vibrations to encourage relaxation, release tension, and restore balance. This experience may also be offered as a mobile service."
          },
          {
            title: "Group Sound Bath Radiance Session",
            description:
              "A shared sound bath experience designed to support collective relaxation, grounding, and energetic renewal. Mobile sessions may be available for private groups, events, and gatherings."
          }
        ]
      },
      {
        title: "Integrated Facial Experiences",
        services: [
          {
            title: "Reiki Infusion Healing Facial",
            description:
              "A personalized facial paired with Reiki to support radiant skin, deep relaxation, and emotional balance."
          },
          {
            title: "Sound Bath Facial Experience",
            description:
              "A rejuvenating facial combined with soothing sound therapy for relaxation, skin vitality, and a calming sensory experience."
          },
          {
            title: "Mind • Body • Frequency Facial",
            description:
              "A two-hour facial experience combining personalized skincare, Reiki, and a private sound bath to leave you feeling refreshed, grounded, and balanced."
          }
        ]
      }
    ]
  }
];
---

<BaseLayout
  title="Services | Sassy Alchemy"
  description="Explore Sassy Alchemy services across lashes and brows, facials and skin, and restorative wellness experiences."
>
  <section class="bg-ivory pt-28 sm:pt-32 lg:pt-36">
    <Container class="grid gap-10 py-16 sm:py-20 lg:grid-cols-[0.82fr_1.18fr] lg:items-end lg:py-24" size="wide">
      <div>
        <p class="text-xs font-semibold uppercase text-gold-deep">Services</p>
        <h1 class="mt-5 max-w-4xl text-balance text-6xl leading-[0.92] sm:text-7xl lg:text-8xl">
          Pick what feels good.
        </h1>
      </div>
      <p class="max-w-2xl text-lg leading-8 text-stone-600 lg:pb-2">
        Lashes, skin, Reiki, sound — maybe a little of everything. Take a look around and find what’s calling you.
      </p>
    </Container>
  </section>

  {categories.map((category, categoryIndex) => {
    const Icon = category.Icon;
    const isDark = category.peaceful;

    return (
      <section
        id={category.id}
        class:list={[
          "services-category",
          isDark ? "bg-forest-900 text-ivory" : categoryIndex % 2 === 0 ? "bg-cream" : "bg-ivory"
        ]}
      >
        <Container class="py-18 sm:py-22 lg:py-30" size="wide">
          <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-stretch">
            <figure class="image-frame group relative min-h-[26rem] overflow-hidden bg-stone-100 sm:min-h-[34rem]">
              <img
                src={withBase(category.image)}
                alt={category.imageAlt}
                loading={categoryIndex === 0 ? "eager" : "lazy"}
                decoding="async"
                class:list={[
                  "absolute inset-0 h-full w-full object-cover transition duration-700 ease-editorial group-hover:scale-[1.035]",
                  "imageClass" in category && category.imageClass
                ]}
              />
              <div class:list={["absolute inset-0", isDark ? "bg-forest-900/18" : "bg-forest-900/8"]}></div>
            </figure>

            <div class="flex flex-col justify-between gap-10">
              <div>
                <div
                  class:list={[
                    "mb-8 flex h-16 w-16 items-center justify-center rounded-full border",
                    isDark ? "border-cream/20 bg-cream/8 text-gold-muted" : "border-stone-200 bg-ivory text-forest-900"
                  ]}
                >
                  <Icon aria-hidden="true" size={24} stroke-width={1.4} />
                </div>
                <p class:list={["text-xs font-semibold uppercase", isDark ? "text-gold-muted" : "text-gold-deep"]}>
                  {category.eyebrow}
                </p>
                {isDark && (
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 58 26"
                    class="mt-4 h-7 w-16 text-gold-muted/85"
                    fill="none"
                  >
                    <path
                      d="M10.5 13.5c6.2-1.8 10.2-5.8 12-12 1.8 6.2 5.8 10.2 12 12-6.2 1.8-10.2 5.8-12 12-1.8-6.2-5.8-10.2-12-12Z"
                      stroke="currentColor"
                      stroke-width="1.35"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M43.5 7.5c2.1-.6 3.4-1.9 4-4 .6 2.1 1.9 3.4 4 4-2.1.6-3.4 1.9-4 4-.6-2.1-1.9-3.4-4-4Z"
                      stroke="currentColor"
                      stroke-width="1.1"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
                {"sectionName" in category && category.sectionName && (
                  <p class="mt-4 font-serif text-3xl leading-none text-cream sm:text-4xl">
                    {category.sectionName}
                  </p>
                )}
                <h2 class:list={["mt-5 max-w-3xl text-5xl leading-none sm:text-6xl", isDark && "text-ivory"]}>
                  {category.title}
                </h2>
                <p class:list={["mt-6 max-w-2xl text-lg leading-8", isDark ? "text-cream/75" : "text-stone-600"]}>
                  {category.intro}
                </p>
              </div>

              {isDark && (
                <div class="hidden border-l border-gold-muted/60 pl-6 text-cream/70 lg:block">
                  <p class="max-w-md">
                    {category.supportLine}
                  </p>
                </div>
              )}
            </div>
          </div>

          <div class="mt-12 lg:mt-16">
            {"serviceGroups" in category && category.serviceGroups ? (
              <div class="grid gap-12">
                {category.serviceGroups.map((group) => (
                  <div>
                    <h3 class="border-b border-cream/15 pb-5 font-serif text-4xl leading-none text-ivory sm:text-5xl">
                      {group.title}
                    </h3>
                    <div class="divide-y divide-cream/15 border-b border-cream/15">
                      {group.services.map((service, serviceIndex) => (
                        <details class="service-panel group">
                          <summary class="grid cursor-pointer list-none gap-5 py-7 transition duration-300 ease-editorial hover:bg-cream/[0.035] sm:grid-cols-[4rem_1fr_auto] sm:items-center lg:py-8">
                            <span class="text-sm text-cream/55">
                              {String(serviceIndex + 1).padStart(2, "0")}
                            </span>
                            <span class="font-serif text-3xl leading-tight text-ivory sm:text-4xl">
                              {service.title}
                            </span>
                            <span class="flex h-11 w-11 items-center justify-center border border-cream/20 bg-cream/[0.03] text-gold-muted transition duration-300 ease-editorial group-hover:-translate-y-0.5 group-hover:border-gold-muted group-open:rotate-180">
                              <ChevronDown aria-hidden="true" size={20} stroke-width={1.5} />
                            </span>
                          </summary>

                          <div class="service-panel__content">
                            <div class="service-panel__inner grid gap-7 pb-8 sm:grid-cols-[4rem_1fr] lg:pb-10">
                              <div class="hidden sm:block"></div>
                              <div class="max-w-3xl">
                                <p class="text-base leading-8 text-cream/75 sm:text-lg">
                                  {service.description}
                                </p>

                                <a
                                  href={site.bookingUrl}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="group/book mt-7 inline-flex min-h-12 items-center gap-3 border border-cream/30 bg-cream px-5 py-3 text-sm font-semibold uppercase text-forest-900 transition duration-300 ease-editorial hover:-translate-y-0.5 hover:border-gold-muted hover:bg-gold-muted focus-visible:-translate-y-0.5 active:translate-y-0"
                                >
                                  <span>Book This Service</span>
                                  <ArrowUpRight aria-hidden="true" size={16} stroke-width={1.6} class="transition duration-300 ease-editorial group-hover/book:translate-x-0.5 group-hover/book:-translate-y-0.5" />
                                </a>
                              </div>
                            </div>
                          </div>
                        </details>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div class:list={["divide-y", isDark ? "divide-cream/15 border-y border-cream/15" : "divide-stone-200 border-y border-stone-200"]}>
                {category.services.map((service, serviceIndex) => (
                  <details class="service-panel group">
                    <summary
                      class:list={[
                        "grid cursor-pointer list-none gap-5 py-7 transition duration-300 ease-editorial sm:grid-cols-[4rem_1fr_auto] sm:items-center lg:py-8",
                        isDark ? "hover:bg-cream/[0.035]" : "hover:bg-ivory/70"
                      ]}
                    >
                      <span class:list={["text-sm", isDark ? "text-cream/55" : "text-stone-400"]}>
                        {String(serviceIndex + 1).padStart(2, "0")}
                      </span>
                      <span class:list={["font-serif text-3xl leading-tight sm:text-4xl", isDark ? "text-ivory" : "text-forest-900"]}>
                        {service.title}
                      </span>
                      <span
                        class:list={[
                          "flex h-11 w-11 items-center justify-center border transition duration-300 ease-editorial group-hover:-translate-y-0.5 group-open:rotate-180",
                          isDark ? "border-cream/20 bg-cream/[0.03] text-gold-muted group-hover:border-gold-muted" : "border-stone-200 bg-ivory text-gold-deep group-hover:border-forest-900"
                        ]}
                      >
                        <ChevronDown aria-hidden="true" size={20} stroke-width={1.5} />
                      </span>
                    </summary>

                    <div class="service-panel__content">
                      <div class="service-panel__inner grid gap-7 pb-8 sm:grid-cols-[4rem_1fr] lg:pb-10">
                        <div class="hidden sm:block"></div>
                        <div class="max-w-3xl">
                          <p class:list={["text-base leading-8 sm:text-lg", isDark ? "text-cream/75" : "text-stone-600"]}>
                            {service.description}
                          </p>

                          {"details" in service && service.details && (
                            <div class="mt-6 flex flex-wrap gap-2">
                              {service.details.map((detail) => (
                                <span
                                  class:list={[
                                    "border px-3 py-2 text-sm transition duration-300",
                                    isDark ? "border-cream/15 text-cream/75" : "border-stone-200 bg-ivory text-stone-600 shadow-[0_8px_18px_rgba(16,42,32,0.035)]"
                                  ]}
                                >
                                  {detail}
                                </span>
                              ))}
                            </div>
                          )}

                          <a
                            href={site.bookingUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class:list={[
                              "group/book mt-7 inline-flex min-h-12 items-center gap-3 border px-5 py-3 text-sm font-semibold uppercase transition duration-300 ease-editorial hover:-translate-y-0.5 focus-visible:-translate-y-0.5 active:translate-y-0",
                              isDark
                                ? "border-cream/30 bg-cream text-forest-900 hover:border-gold-muted hover:bg-gold-muted"
                                : "border-forest-900 bg-forest-900 text-ivory hover:border-gold-muted hover:bg-gold-muted hover:text-forest-900"
                            ]}
                          >
                            <span>Book This Service</span>
                            <ArrowUpRight aria-hidden="true" size={16} stroke-width={1.6} class="transition duration-300 ease-editorial group-hover/book:translate-x-0.5 group-hover/book:-translate-y-0.5" />
                          </a>
                        </div>
                      </div>
                    </div>
                  </details>
                ))}
              </div>
            )}
          </div>
        </Container>
      </section>
    );
  })}

  <section id="visiting-practitioner" class="bg-ivory">
    <Container class="py-12 sm:py-14 lg:py-16" size="wide">
      <div class="mx-auto grid max-w-5xl gap-7 border-y border-gold-muted/40 bg-cream p-5 sm:p-6 lg:grid-cols-[0.28fr_0.72fr] lg:items-center lg:p-7">
        <figure class="image-frame group relative mx-auto aspect-[4/5] w-full max-w-[18rem] overflow-hidden bg-stone-100 sm:max-w-[20rem] lg:mx-0 lg:max-w-none">
          <img
            src={withBase("/images/staysea-visiting-practitioner.jpg")}
            alt="StaySea of The Sea Wytch, visiting practitioner at Sassy Alchemy."
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover object-[50%_34%] transition duration-700 ease-editorial group-hover:scale-[1.025]"
          />
          <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-forest-900/12 via-transparent to-ivory/10"></div>
        </figure>

        <div class="relative py-2 lg:px-3">
          <svg
            aria-hidden="true"
            viewBox="0 0 98 40"
            class="mb-4 h-7 w-20 text-gold-deep/70"
            fill="none"
          >
            <path
              d="M2 29c18.5-13.5 41-16.7 68-9.6 8 2.1 16.6 2.3 25.8.6"
              stroke="currentColor"
              stroke-width="1.15"
              stroke-linecap="round"
            />
            <path
              d="M20.5 10.5c3.6-1.1 5.9-3.4 7-7 1.1 3.6 3.4 5.9 7 7-3.6 1.1-5.9 3.4-7 7-1.1-3.6-3.4-5.9-7-7Z"
              stroke="currentColor"
              stroke-width="1.15"
              stroke-linejoin="round"
            />
            <path
              d="M77 9c2.1-.6 3.4-1.9 4-4 .6 2.1 1.9 3.4 4 4-2.1.6-3.4 1.9-4 4-.6-2.1-1.9-3.4-4-4Z"
              stroke="currentColor"
              stroke-width="1"
              stroke-linejoin="round"
            />
          </svg>

          <p class="font-serif text-4xl leading-none text-forest-900 sm:text-5xl">Tarot</p>
          <p class="mt-4 text-xs font-semibold uppercase text-gold-deep">Visiting Practitioner</p>
          <h2 class="mt-3 max-w-2xl text-3xl leading-none sm:text-4xl">
            StaySea • The Sea Wytch
          </h2>
          <p class="mt-3 font-serif text-xl italic leading-snug text-gold-deep sm:text-2xl">
            Tarot, astrology &amp; a little everyday magic.
          </p>

          <div class="mt-5 grid max-w-3xl gap-3 text-base leading-7 text-stone-600">
            <p>
              StaySea is the creator behind The Sea Wytch, a modern metaphysical practice rooted in tarot, astrology, apothecary magic, and intentional living.
            </p>
            <p>
              Through readings, workshops, and hands-on experiences, she invites people to explore their intuition, creativity, and personal magic in a way that feels approachable and practical.
            </p>
          </div>

          <p class="mt-5 border-y border-gold-muted/35 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-forest-900">
            Tarot Readings • Astrology • Workshops • Apothecary
          </p>

          <p class="mt-4 max-w-2xl text-sm leading-7 text-stone-600">
            Find StaySea at Sassy Alchemy for select readings, workshops &amp; special events throughout the year.
          </p>

          <a
            href="https://theseawytch.square.site"
            target="_blank"
            rel="noopener noreferrer"
            class="group/book mt-6 inline-flex min-h-11 items-center gap-3 border border-forest-900 bg-transparent px-4 py-3 text-sm font-semibold uppercase text-forest-900 transition duration-300 ease-editorial hover:-translate-y-0.5 hover:border-gold-muted hover:bg-gold-muted focus-visible:-translate-y-0.5 active:translate-y-0"
          >
            <span>Explore The Sea Wytch</span>
            <ArrowUpRight aria-hidden="true" size={16} stroke-width={1.6} class="transition duration-300 ease-editorial group-hover/book:translate-x-0.5 group-hover/book:-translate-y-0.5" />
          </a>
        </div>
      </div>
    </Container>
  </section>

  <section class="bg-ivory">
    <Container class="py-16 text-center sm:py-20">
      <HandHeart aria-hidden="true" size={28} stroke-width={1.4} class="mx-auto text-gold-deep" />
      <h2 class="mx-auto mt-6 max-w-3xl text-5xl leading-none sm:text-6xl">
        What are you feeling?
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-stone-600">
        Take your pick. Timing, pricing and booking are all handled through Vagaro.
      </p>
      <a
        href={site.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group/book mt-8 inline-flex min-h-12 items-center gap-3 border border-forest-900 bg-forest-900 px-5 py-3 text-sm font-semibold uppercase text-ivory shadow-[0_12px_28px_rgba(16,42,32,0.12)] transition duration-300 ease-editorial hover:-translate-y-0.5 hover:border-gold-muted hover:bg-gold-muted hover:text-forest-900 focus-visible:-translate-y-0.5 active:translate-y-0"
      >
        <span>Book</span>
        <ArrowUpRight aria-hidden="true" size={16} stroke-width={1.6} class="transition duration-300 ease-editorial group-hover/book:translate-x-0.5 group-hover/book:-translate-y-0.5" />
      </a>
    </Container>
  </section>

  <style>
    .service-panel summary::-webkit-details-marker {
      display: none;
    }

    .service-panel summary {
      border-radius: 2px;
    }

    .service-panel__content {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      transition:
        grid-template-rows 520ms var(--ease-editorial),
        opacity 420ms var(--ease-editorial);
    }

    .service-panel[open] .service-panel__content {
      grid-template-rows: 1fr;
      opacity: 1;
    }

    .service-panel__inner {
      overflow: hidden;
    }
  </style>
</BaseLayout>
