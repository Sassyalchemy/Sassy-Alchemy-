---
import MobileNav from "@components/layout/MobileNav.astro";
import { navigationItems } from "@content/navigation";
import { site } from "@content/site";
import { withBase } from "@content/paths";

const pathname = Astro.url.pathname;

function isActive(href: string) {
  const base = import.meta.env.BASE_URL;
  const normalizedPath = pathname.replace(base, "/");

  if (href === "/") {
    return normalizedPath === "/" || normalizedPath === "";
  }

  return normalizedPath.startsWith(href);
}
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-stone-200/75 bg-cream/90 shadow-[0_8px_30px_rgba(16,42,32,0.035)] backdrop-blur-md">
  <div class="mx-auto flex min-h-20 max-w-site items-center justify-between px-5 sm:px-8 lg:px-10">
    <a href={withBase("/")} class="group inline-flex flex-col leading-none transition duration-300 ease-editorial hover:-translate-y-px" aria-label={`${site.name} home`}>
      <span class="font-serif text-[1.94rem] text-forest-900 transition group-hover:text-gold-deep sm:text-[2.04rem]">{site.name}</span>
      <span class="mt-1 text-[0.81rem] uppercase text-stone-600">Beauty & Wellness Studio</span>
    </a>

    <nav class="hidden lg:block" aria-label="Main navigation">
      <ul class="flex items-center gap-8">
        {navigationItems.map((item) => (
          <li>
            <a
              href={withBase(item.href)}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "relative py-2 text-sm font-medium uppercase text-stone-600 transition duration-300 ease-editorial after:absolute after:inset-x-0 after:-bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-gold-muted after:transition after:duration-300 hover:text-forest-900 hover:after:scale-x-100",
                isActive(item.href) && "text-forest-900 after:scale-x-100"
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <MobileNav />
  </div>
</header>
