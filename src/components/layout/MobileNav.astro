---
import { Menu, X } from "@lucide/astro";
import { navigationItems } from "@content/navigation";
import { withBase } from "@content/paths";
---

<details class="group lg:hidden">
  <summary
    class="flex min-h-11 cursor-pointer list-none items-center gap-2 border border-stone-200 bg-ivory px-3 text-sm font-semibold uppercase text-forest-900 shadow-[0_10px_24px_rgba(16,42,32,0.06)] transition duration-300 ease-editorial hover:-translate-y-px hover:border-forest-900"
    aria-label="Open navigation"
  >
    <Menu class="group-open:hidden" aria-hidden="true" size={18} stroke-width={1.6} />
    <X class="hidden group-open:block" aria-hidden="true" size={18} stroke-width={1.6} />
    Menu
  </summary>
  <nav
    aria-label="Mobile navigation"
    class="absolute left-5 right-5 top-[calc(100%+0.75rem)] border border-stone-200 bg-ivory/95 p-5 shadow-soft backdrop-blur-md"
  >
    <ul class="grid gap-1">
      {navigationItems.map((item) => (
        <li>
          <a
            href={withBase(item.href)}
            class="block border-b border-stone-100 px-1 py-3 font-serif text-2xl text-forest-900 transition duration-300 ease-editorial hover:translate-x-1 hover:text-gold-deep"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</details>
