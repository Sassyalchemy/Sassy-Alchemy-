---
import { withBase } from "@content/paths";

type Props = {
  src: string;
  alt: string;
  ratio?: "portrait" | "landscape" | "square" | "wide";
  class?: string;
  loading?: "eager" | "lazy";
};

const { src, alt, ratio = "landscape", class: className = "", loading = "lazy" } = Astro.props;

const ratios = {
  portrait: "aspect-[4/5]",
  landscape: "aspect-[5/4]",
  square: "aspect-square",
  wide: "aspect-[16/9]"
};
---

<figure class:list={["image-frame group relative overflow-hidden bg-stone-100", ratios[ratio], className]}>
  <img
    src={withBase(src)}
    alt={alt}
    loading={loading}
    decoding="async"
    class="h-full w-full object-cover transition duration-700 ease-editorial group-hover:scale-[1.03]"
  />
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-t from-forest-900/10 via-transparent to-ivory/10 opacity-70 transition duration-700 group-hover:opacity-45"></div>
</figure>
