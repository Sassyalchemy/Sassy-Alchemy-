---
import { ArrowUpRight } from "@lucide/astro";

type Props = {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  label?: string;
  class?: string;
};

const { href, variant = "primary", label, class: className = "" } = Astro.props;

const variants = {
  primary:
    "border-forest-900 bg-forest-900 text-ivory shadow-[0_12px_28px_rgba(16,42,32,0.12)] hover:border-gold-muted hover:bg-gold-muted hover:text-forest-900",
  secondary:
    "border-stone-200 bg-ivory text-forest-900 shadow-[0_10px_24px_rgba(16,42,32,0.06)] hover:border-forest-900 hover:bg-forest-900 hover:text-ivory",
  ghost:
    "border-transparent bg-transparent text-forest-900 hover:border-stone-200 hover:bg-ivory"
};
---

<a
  href={href}
  aria-label={label}
  class:list={[
    "group/button relative inline-flex min-h-12 items-center gap-3 overflow-hidden border px-5 py-3 text-sm font-semibold uppercase transition duration-300 ease-editorial hover:-translate-y-0.5 focus-visible:-translate-y-0.5 active:translate-y-0",
    variants[variant],
    className
  ]}
>
  <span><slot /></span>
  <ArrowUpRight aria-hidden="true" size={16} stroke-width={1.6} class="transition duration-300 ease-editorial group-hover/button:translate-x-0.5 group-hover/button:-translate-y-0.5" />
</a>
